<Window x:Class="FtpWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FtpWatcher"
        mc:Ignorable="d"
        Title="FTP Watcher" Height="640" Width="960"
        Background="#F4F6F8"
        FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing">
    <Window.Resources>
        <ContextMenu x:Key="FolderEntryContextMenu">
            <MenuItem Header="Open" Click="OpenFolderMenuItem_Click"/>
        </ContextMenu>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox" x:Key="InputPwdBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C5282"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#4A5568"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3748"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="DeleteButton">
            <Setter Property="Background" Value="#E53E3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C53030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="CopyButton">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2F855A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header / Input panel -->
        <Border DockPanel.Dock="Top" Background="White" Padding="16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Row 1: FTP connection -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="FTP server address"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Username" Margin="12,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Password" Margin="12,0,0,4"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="ServerAddressTextBox"
                             Style="{StaticResource InputBox}"
                             Text="ftp://"
                             KeyDown="ServerAddressTextBox_KeyDown"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="UsernameTextBox"
                             Style="{StaticResource InputBox}"
                             Text="anonymous"
                             Margin="12,0,0,0"/>
                    <PasswordBox Grid.Row="1" Grid.Column="2"
                                 x:Name="PasswordBox"
                                 Style="{StaticResource InputPwdBox}"
                                 Margin="12,0,0,0"/>
                    <Button Grid.Row="1" Grid.Column="3"
                            x:Name="ListButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="List folder"
                            Margin="12,0,0,0"
                            Click="ListButton_Click"/>
                </Grid>

                <!-- Row 2: destination folder -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Destination folder"/>
                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="DestinationFolderTextBox"
                             Style="{StaticResource InputBox}"/>
                    <Button Grid.Row="1" Grid.Column="1"
                            x:Name="ChooseFolderButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Choose folder"
                            Margin="12,0,0,0"
                            Click="ChooseFolderButton_Click"/>
                </Grid>

                <!-- Row 3: watch settings -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Refresh timeout (seconds)"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource FieldLabel}" Text="Watch" Margin="12,0,0,4"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="RefreshTimeoutTextBox"
                             Style="{StaticResource InputBox}"
                             Width="100"
                             HorizontalAlignment="Left"
                             Text="60"
                             MaxLength="6"
                             PreviewTextInput="RefreshTimeoutTextBox_PreviewTextInput"
                             LostFocus="RefreshTimeoutTextBox_LostFocus"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <Button x:Name="StartWatchButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Start watch"
                                Click="StartWatchButton_Click"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="WatchTimeRemainingTextBlock"
                                       Foreground="#4A5568"
                                       FontSize="11"
                                       Margin="0,0,0,4"
                                       Visibility="Collapsed"
                                       Text="Next refresh in 60 s"/>
                            <ProgressBar x:Name="WatchTimeoutProgressBar"
                                         Width="140"
                                         Height="10"
                                         Minimum="0"
                                         Maximum="100"
                                         Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#EDF2F7" Padding="12,6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Foreground="#4A5568" Text="Ready."/>
                <ProgressBar x:Name="BusyProgressBar" Grid.Column="1"
                             Width="120" Height="10"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Main list view -->
        <Border Padding="16">
            <ListView x:Name="EntriesListView"
                      BorderBrush="#E2E8F0"
                      Background="White"
                      AlternationCount="2"
                      MouseDoubleClick="EntriesListView_MouseDoubleClick">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="#F7FAFC"/>
                    </Style>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="ContextMenu" Value="{StaticResource FolderEntryContextMenu}"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F7FAFC"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static local:FtpEntryType.File}">
                                <Setter Property="ContextMenu" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static local:FtpEntryType.Symlink}">
                                <Setter Property="ContextMenu" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static local:FtpEntryType.Unknown}">
                                <Setter Property="ContextMenu" Value="{x:Null}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Type" Width="72" DisplayMemberBinding="{Binding TypeLabel}"/>
                        <GridViewColumn Header="Name" Width="280" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeLabel}"/>
                        <GridViewColumn Header="Modified" Width="150" DisplayMemberBinding="{Binding ModifiedLabel}"/>
                        <GridViewColumn Header="" Width="72">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Copy"
                                            Click="CopyEntryButton_Click"
                                            Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CopyButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsParentLink}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="72">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete"
                                            Click="DeleteEntryButton_Click"
                                            Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DeleteButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsParentLink}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
